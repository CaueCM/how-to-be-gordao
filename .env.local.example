# Copie este arquivo para .env.local (que já está no .gitignore) e preencha.

# Gere com: openssl rand -base64 33
AUTH_SECRET=

# Do OAuth Client criado no Google Cloud Console (tipo "Web application")
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# String de conexão do Postgres (Vercel Storage → seu banco → .env.local tab)
DATABASE_URL=
